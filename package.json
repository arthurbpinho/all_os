{
  "name": "allos-platform",
  "version": "1.0.0",
  "description": "Plataforma de Simulação Gamificada Allos",
  "scripts": {
    "server": "node server/index.js",
    "client": "cd client && npx vite --host",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm install && npx vite build",
    "start": "node server/index.js",
    "postinstall": "cd client && npm install",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.96.0",
    "bcryptjs": "3.0.3",
    "concurrently": "8.2.2",
    "cors": "2.8.6",
    "dotenv": "17.4.1",
    "express": "4.22.2",
    "express-rate-limit": "7.5.1",
    "jsonwebtoken": "9.0.3",
    "openai": "6.38.0"
  },
  "devDependencies": {
    "supertest": "7.2.2",
    "vitest": "2.1.9"
  }
}

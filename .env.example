# ===== Variáveis de ambiente — Allos =====
# Copie para .env (local) ou configure no painel Railway > Variables (produção).

# OpenAI (obrigatório para chat/avaliação/transcrição)
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5.4-mini

# JWT — assina os tokens de sessão. OBRIGATÓRIO em todos os ambientes; o
# servidor encerra se ausente ou com menos de 32 chars. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Trocar este valor invalida todas as sessões existentes (todos são deslogados).
JWT_SECRET=

# Senha inicial do admin no primeiro deploy (somente quando users.json ainda
# não existe). OBRIGATÓRIA com no mínimo 12 chars — o servidor encerra se
# faltar/curta. Após o primeiro login, troque pela tela de Perfil. Gere com:
#   openssl rand -base64 24
ADMIN_INITIAL_PASSWORD=

# Origens permitidas pelo CORS (CSV). Em produção, o frontend é servido pelo
# próprio Express, então same-origin sempre passa — só precisa abrir pra dev
# local. Default: http://localhost:5173.
CORS_ALLOWLIST=http://localhost:5173

# Porta HTTP. Railway injeta automaticamente; em local fica 3001.
PORT=3001

# Caminho dos JSONs de dados. Em Railway: aponte para o mount do volume
# (ex: /data). Em local: deixe vazio para usar server/data/.
DATA_DIR=

# ===== Variáveis de ambiente — Allos =====
# Copie para .env (local) ou configure no painel Railway > Variables (produção).

# OpenAI (obrigatório para chat/avaliação/transcrição)
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-5.4-mini

# JWT — assina os tokens de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# OBRIGATÓRIO em produção. Trocar este valor invalida todas as sessões existentes.
JWT_SECRET=

# Senha inicial do admin no primeiro deploy (somente quando users.json ainda não existe).
# Após o primeiro login, troque pela tela de Perfil.
ADMIN_INITIAL_PASSWORD=admin123

# Porta HTTP. Railway injeta automaticamente; em local fica 3001.
PORT=3001

# Caminho dos JSONs de dados. Em Railway: aponte para o mount do volume
# (ex: /data). Em local: deixe vazio para usar server/data/.
DATA_DIR=

node_modules/
client/dist/
.env

# Certificado da credencial do app de e-mail (Microsoft Graph). A chave privada
# vive só nesta máquina e no painel de variáveis do Railway — nunca no git.
.certs/

# Dados de runtime — NÃO versionar (contém senhas hash, logs, progresso, etc.)
# Persistência em produção: via volume mount da Railway (DATA_DIR=/data),
# não via git. Cada ambiente (local / prod) tem o seu próprio estado.
server/data/users.json
server/data/progress.json
server/data/logs.json
server/data/achievements.json
server/data/active-sessions.json
server/data/migrations.json
server/data/mmr.json
server/data/duels.json
server/data/notifications.json
server/data/character-records.json
server/data/selection-logs.json
server/data/selection-stats.json
server/data/avaliacao-fila.json
server/data/antessala.json
server/data/counters.json
server/data/daily-missions.json
server/data/error-logs.json
# Cadastro público: pendências aguardando confirmação (hash de senha, e-mail, IP),
# pedidos de redefinição de senha e trocas de e-mail. São efêmeros (48h / 1h) e
# NUNCA devem sair da máquina.
server/data/pending-registrations.json
server/data/password-resets.json
server/data/email-changes.json
# Inscrições de Web Push: contêm endpoint + chaves por dispositivo.
server/data/push-subscriptions.json
server/data/tmp_audio.webm
server/data/tmp_audio_*.webm

# Fotos de paciente enviadas em runtime (ficam no volume DATA_DIR, não no repo)
server/data/patient-photos/
server/data/avaliacao-v25.json
# Resumos de raciocínio das avaliações do v28 (um .txt por run, no volume)
server/data/avaliacao-reasoning/
# Detalhe por critério das avaliações de PRODUÇÃO (avaliador oficial v29): um
# .json por avaliação, com as quinze análises. É material de supervisor e
# contém leitura feita com o gabarito do caso à vista — nunca vai pro git.
server/data/avaliacoes-criterios/
server/data/benchmark-fila.json
# Contabilidade da fila da Batch API (quais batches estão em voo e quantos
# tokens cada um reserva). Estado de runtime, compartilhado por Competitivo,
# Seletivo, Trilha e Avaliação Independente.
server/data/batch-ledger.json
server/data/benchmark-lotes.json
# Runs do Benchmarking de Simulação (uma por arquivo: transcrição + custo por
# interação + resumo do raciocínio). Ficam no volume, fora do git.
server/data/benchmark-runs/

# Prompts do avaliador/entrevistador — dados sensíveis (critérios de nota,
# gabaritos). Fora do git; vivem só no volume persistente (server/paths.js
# PROMPTS_DIR), semeados uma vez a partir destas pastas e atualizados depois
# via /api/admin/prompts (não por git push).
avaliacao/
entrevistador/

# JSONs de dados com conteúdo clínico/pedagógico sensível (gabarito de
# neuropsicológica, evaluatorPrompt por exercício, prompts dos pacientes
# simulados). Produção já lê exclusivamente do volume (DATA_DIR) para estes
# arquivos — ver server/index.js (seed só copia se o arquivo não existir lá).
server/data/exercises.json
server/data/freeplay-characters.json
server/data/neuro-characters.json

# Documentação interna e material de apoio — ficam só na máquina, fora do git.
SEGURANCA.md
.manuais/
# Comunidade: as discussões são conteúdo escrito pelos usuários, e a config leva
# os banimentos. O servidor cria os dois vazios no boot (ver index.js), então
# nada precisa estar versionado aqui.
server/data/comunidade.json
server/data/comunidade-config.json
# Avatar da Associação Allos, subido pelo admin em runtime.
server/data/comunidade-avatars/
# Pool de fotos padrão (Administração → Contas): as imagens que servem de avatar
# pra quem não tem foto própria. Sobem pelo painel e ficam no volume DATA_DIR —
# nem os bytes nem a lista entram no repo.
server/data/avatar-pool/
server/data/avatar-pool.json
# Estado de runtime que estava versionado por engano (removido do índice em
# 2026-08-28). O servidor recria os três no boot — o banco inicial de exercícios
# virou SIDEQUEST_BANK_SEED em server/index.js.
#   sidequests.json         → `completed` guarda a justificativa da conclusão,
#                             que descreve o atendimento do aluno.
#   feedback.json           → mensagens escritas pelos usuários.
#   achievement-unlocks.json→ quais conquistas cada conta já recebeu.
server/data/sidequests.json
server/data/feedback.json
server/data/achievement-unlocks.json
